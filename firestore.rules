rules_version = '2';

// ============================================================
//  Bot Script Store — Firestore Security Rules
//  ★ নিচের OWNER_EMAIL-এ আপনার Gmail দিন (অ্যাডমিন) ★
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    // ★ নিচের ইমেইলটা আপনার Gmail দিয়ে বদলান।
    // বড়/ছোট হাতের অক্ষর নিয়ে চিন্তা নেই — দুই পাশই lowercase করে মেলানো হয়।
    function ownerEmail() {
      return 'junayedsiddiqe518@gmail.com'.lower();
    }
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.get('email', '').lower() == ownerEmail()
        && request.auth.token.get('email_verified', false) == true;
    }
    function isAdmin() {
      return isOwnerEmail()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function orderPath(oid) {
      return /databases/$(database)/documents/orders/$(oid);
    }
    function productPath(pid) {
      return /databases/$(database)/documents/products/$(pid);
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // নিজের প্রোফাইল তৈরি — ব্যালেন্স অবশ্যই ০
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.balance == 0
        && request.resource.data.keys().hasOnly(
             ['name','username','tg_id','photo_url','email','provider','balance','created_at','last_order']);

      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && (
             // (ক) শুধু প্রোফাইল আপডেট — ব্যালেন্স বদলানো যাবে না
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name','username','tg_id','photo_url','email','provider','updated_at'])
             ||
             // (খ) কেনাকাটা — একই commit-ে অর্ডার তৈরি হতে হবে ও দাম কাটতে হবে
             (
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','last_order'])
               && request.resource.data.balance <= resource.data.balance
               && getAfter(orderPath(uid + '_' + request.resource.data.last_order)).data.uid == uid
               && getAfter(orderPath(uid + '_' + request.resource.data.last_order)).data.status == 'approved'
               && getAfter(orderPath(uid + '_' + request.resource.data.last_order)).data.amount
                    == resource.data.balance - request.resource.data.balance
               && get(productPath(request.resource.data.last_order)).data.price
                    == resource.data.balance - request.resource.data.balance
             )
           ));

      allow delete: if isAdmin();
    }

    // ---------- products (সবাই দেখতে পারে) ----------
    match /products/{pid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- deliveries (শুধু ক্রেতা / অ্যাডমিন) ----------
    match /deliveries/{pid} {
      allow read: if isAdmin()
        || (signedIn()
            && exists(orderPath(request.auth.uid + '_' + pid))
            && get(orderPath(request.auth.uid + '_' + pid)).data.status == 'approved');
      allow write: if isAdmin();
    }

    // ---------- orders ----------
    match /orders/{oid} {
      // get: ডকুমেন্ট এখনো না থাকলেও (কেনার আগে চেক) অনুমতি দিতে হবে,
      // তাই resource.data নয় — ডকুমেন্ট ID থেকেই মালিকানা যাচাই করা হয়।
      allow get: if isAdmin() || (signedIn() && oid.split('_')[0] == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // কেনাকাটা — একই commit-ে ব্যালেন্স কাটা বাধ্যতামূলক
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && oid == request.auth.uid + '_' + request.resource.data.product_id
        && request.resource.data.status == 'approved'
        && request.resource.data.amount == get(productPath(request.resource.data.product_id)).data.price
        && get(productPath(request.resource.data.product_id)).data.active == true
        && get(userPath(request.auth.uid)).data.balance >= request.resource.data.amount
        && getAfter(userPath(request.auth.uid)).data.balance
             == get(userPath(request.auth.uid)).data.balance - request.resource.data.amount
        && request.resource.data.keys().hasOnly(
             ['uid','user_name','product_id','product_title','amount','currency','status','license_key','created_at']);

      allow update, delete: if isAdmin();
    }

    // ---------- deposits ----------
    // ডকুমেন্ট ID = Transaction ID → একই TrxID দুইবার ব্যবহার অসম্ভব
    match /deposits/{trx} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.trx_id == trx
        && request.resource.data.keys().hasOnly(
             ['uid','user_name','amount','currency','payment_method','trx_id','status','admin_note','created_at']);

      allow update, delete: if isAdmin();
    }

    // ---------- settings ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- admins (Firebase console থেকে যোগ করবেন) ----------
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ---------- বাকি সব বন্ধ ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}   
